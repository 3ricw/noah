    // =========================================================================
    // STEP 3: AUSTIN CONCERT DISCOVERY ENGINE
    // =========================================================================
    async function scanForShows() {
      if (isScanning) return;

      syncTextToArtistMap();
      const allArtists = Array.from(artistMetadataMap.values());
      if (allArtists.length === 0) {
        showToast('Please enter or upload at least one artist first.', 'error');
        return;
      }

      const maxLimit = parseInt(document.getElementById('maxScanSelect').value, 10) || 30;
      const artistsToScan = allArtists.slice(0, maxLimit);
      const apiKey = document.getElementById('apiKeyInput').value.trim();
      const includeMetro = document.getElementById('includeSurroundingCities').checked;

      isScanning = true;
      scanResults = [];
      document.getElementById('emptyState').classList.add('hidden');
      document.getElementById('resultsGrid').innerHTML = '';

      const progressContainer = document.getElementById('progressContainer');
      const progressBar = document.getElementById('progressBar');
      const progressLabel = document.getElementById('progressLabel');
      const progressPercent = document.getElementById('progressPercent');
      const scanBtn = document.getElementById('scanBtn');

      progressContainer.classList.remove('hidden');
      scanBtn.disabled = true;
      scanBtn.classList.add('opacity-70');

      for (let i = 0; i < artistsToScan.length; i++) {
        const artistObj = artistsToScan[i];
        const pct = Math.round(((i + 1) / artistsToScan.length) * 100);
        progressBar.style.width = `${pct}%`;
        progressPercent.textContent = `${pct}%`;
        progressLabel.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin"></i> Checking Austin venues for "${escapeHTML(artistObj.name)}" (${i + 1}/${artistsToScan.length})...`;

        if (apiKey) {
          const liveMatches = await fetchTicketmasterAustin(artistObj, apiKey, includeMetro);
          scanResults.push(...liveMatches);
          // Polite rate-limit spacing (Ticketmaster allows 5 req/sec)
          if (i < artistsToScan.length - 1) {
            await new Promise(r => setTimeout(r, 230));
          }
        } else {
          const demoMatch = await simulateAustinLookup(artistObj);
          scanResults.push(demoMatch);
        }

        updateTabCounts();
        renderAllCards();
      }

      progressContainer.classList.add('hidden');
      scanBtn.disabled = false;
      scanBtn.classList.remove('opacity-70');
      isScanning = false;

      const playingCount = scanResults.filter(r => r.found).length;
      if (playingCount > 0) {
        document.getElementById('exportBtn').classList.remove('hidden');
        showToast(`Scan complete! Found ${playingCount} upcoming Austin show(s).`, 'success');
      } else {
        showToast('Scan complete! No Austin dates matched.', 'info');
      }
    }

    // Live Ticketmaster API lookup for Austin, TX (plus optional metro area)
    async function fetchTicketmasterAustin(artistObj, apiKey, includeMetro) {
      try {
        // Use latlong around downtown Austin (30.2672, -97.7431) with radius if metro is checked, or strict city=Austin
        const locationParams = includeMetro
          ? `latlong=30.2672,-97.7431&radius=35&unit=miles`
          : `city=Austin&stateCode=TX`;

        const url = `https://app.ticketmaster.com/discovery/v2/events.json?keyword=${encodeURIComponent(artistObj.name)}&${locationParams}&classificationName=music&sort=date,asc&apikey=${encodeURIComponent(apiKey)}`;
        const response = await fetch(url);

        if (response.status === 429) {
          // Rate limit retry wait
          await new Promise(r => setTimeout(r, 1000));
          return [{
            artist: artistObj.name,
            trackCount: artistObj.trackCount,
            genre: artistObj.genre,
            found: false,
            error: 'Rate limited by Ticketmaster — try scanning fewer artists at once.',
            mode: 'Live API'
          }];
        }

        const data = await response.json();
        const events = data._embedded?.events || [];

        // Filter events to ensure the artist keyword reasonably matches an attraction or event name
        const targetLower = artistObj.name.toLowerCase();
        const relevantEvents = events.filter(ev => {
          const evName = (ev.name || '').toLowerCase();
          const attractions = (ev._embedded?.attractions || []).map(a => (a.name || '').toLowerCase());
          return evName.includes(targetLower) || attractions.some(a => a.includes(targetLower));
        });

        if (relevantEvents.length > 0) {
          return relevantEvents.slice(0, 2).map(ev => {
            const venueObj = ev._embedded?.venues?.[0];
            const venueName = venueObj?.name || 'Austin Venue';
            const cityName = venueObj?.city?.name || 'Austin';
            const rawDate = ev.dates?.start?.localDate || '';
            const formattedDate = rawDate ? formatReadableDate(rawDate) : 'Date TBA';
            const time = ev.dates?.start?.localTime ? formatTime(ev.dates.start.localTime) : '';
            const priceRange = ev.priceRanges?.[0]
              ? `$${Math.round(ev.priceRanges[0].min)} – $${Math.round(ev.priceRanges[0].max)}`
              : '';

            return {
              artist: artistObj.name,
              trackCount: artistObj.trackCount,
              genre: artistObj.genre,
              eventName: ev.name,
              venue: cityName !== 'Austin' ? `${venueName} (${cityName})` : venueName,
              date: `${formattedDate} ${time}`.trim(),
              rawDate: rawDate,
              price: priceRange,
              url: ev.url || `https://www.ticketmaster.com/search?q=${encodeURIComponent(artistObj.name + ' Austin')}`,
              found: true,
              mode: 'Live Ticketmaster'
            };
          });
        } else {
          return [{
            artist: artistObj.name,
            trackCount: artistObj.trackCount,
            genre: artistObj.genre,
            found: false,
            mode: 'Live Ticketmaster'
          }];
        }
      } catch (err) {
        return [{
          artist: artistObj.name,
          trackCount: artistObj.trackCount,
          genre: artistObj.genre,
          found: false,
          error: 'Could not reach Ticketmaster API.',
          mode: 'Live API'
        }];
      }
    }

    // Simulated lookup for instant testing without an API key
    async function simulateAustinLookup(artistObj) {
      await new Promise(r => setTimeout(r, 120));
      const venues = [
        "Moody Center",
        "ACL Live at The Moody Theater",
        "Stubb's Waller Creek Amphitheater",
        "Mohawk Austin (Red River Cultural District)",
        "Emo's Austin",
        "Germania Insurance Amphitheater (COTA)",
        "Historic Scoot Inn",
        "Empire Control Room & Garage",
        "Moody Amphitheater at Waterloo Park"
      ];

      const hash = artistObj.name.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
      const isPlaying = hash % 3 !== 0;

      if (isPlaying) {
        const venue = venues[hash % venues.length];
        const futureDate = new Date();
        futureDate.setDate(futureDate.getDate() + (hash % 75) + 6);
        const dateStr = futureDate.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
        const isoDate = futureDate.toISOString().split('T')[0];

        return {
          artist: artistObj.name,
          trackCount: artistObj.trackCount,
          genre: artistObj.genre,
          eventName: `${artistObj.name} — Live in Austin`,
          venue: venue,
          date: `${dateStr} • 8:00 PM`,
          rawDate: isoDate,
          price: `$${35 + (hash % 45)} – $${85 + (hash % 60)}`,
          url: `https://www.ticketmaster.com/search?q=${encodeURIComponent(artistObj.name + ' Austin')}`,
          found: true,
          mode: 'Demo Simulation'
        };
      } else {
        return {
          artist: artistObj.name,
          trackCount: artistObj.trackCount,
          genre: artistObj.genre,
          found: false,
          mode: 'Demo Simulation'
        };
      }
    }

    // =========================================================================
    // FILTERING, RENDERING & EXPORTING CARDS
    // =========================================================================
    function setFilterTab(tab) {
      currentFilterTab = tab;
      ['all', 'playing', 'none'].forEach(t => {
        const btn = document.getElementById(`tab-${t}`);
        if (t === tab) {
          btn.className = 'flex-1 sm:flex-initial px-3 py-1.5 rounded-lg text-xs font-semibold transition bg-pink-600 text-white';
        } else {
          btn.className = 'flex-1 sm:flex-initial px-3 py-1.5 rounded-lg text-xs font-semibold transition text-slate-400 hover:text-white';
        }
      });
      renderAllCards();
    }

    function updateTabCounts() {
      const total = scanResults.length;
      const playing = scanResults.filter(r => r.found).length;
      const none = total - playing;

      document.getElementById('count-all').textContent = total;
      document.getElementById('count-playing').textContent = playing;
      document.getElementById('count-none').textContent = none;
    }

    function renderAllCards() {
      const container = document.getElementById('resultsGrid');
      const searchFilter = document.getElementById('resultFilterInput').value.trim().toLowerCase();
      container.innerHTML = '';

      // Sort so "Playing in Austin" shows appear first
      const sorted = [...scanResults].sort((a, b) => {
        if (a.found && !b.found) return -1;
        if (!a.found && b.found) return 1;
        return (b.trackCount || 0) - (a.trackCount || 0);
      });

      const filtered = sorted.filter(item => {
        if (currentFilterTab === 'playing' && !item.found) return false;
        if (currentFilterTab === 'none' && item.found) return false;
        if (searchFilter) {
          const hay = `${item.artist} ${item.venue || ''} ${item.eventName || ''} ${item.genre || ''}`.toLowerCase();
          return hay.includes(searchFilter);
        }
        return true;
      });

      if (filtered.length === 0 && scanResults.length > 0) {
        container.innerHTML = `
          <div class="sm:col-span-2 glass rounded-2xl p-8 text-center text-slate-400 text-xs">
            No results match your current filter. Try switching tabs above.
          </div>
        `;
        return;
      }

      filtered.forEach(item => {
        const card = document.createElement('div');
        const do512Url = `https://do512.com/search?q=${encodeURIComponent(item.artist)}`;
        const bandsintownUrl = `https://www.bandsintown.com/a/${encodeURIComponent(item.artist)}`;
        const songkickUrl = `https://www.songkick.com/search?utf8=%E2%9C%93&type=initial&query=${encodeURIComponent(item.artist + ' Austin')}`;

        const appleBadge = item.trackCount > 1
          ? `<span class="px-2 py-0.5 rounded-md bg-pink-500/15 text-pink-300 border border-pink-500/25 text-[10px] font-semibold">
               <i class="fa-brands fa-apple mr-1"></i>${item.trackCount} tracks in library
             </span>`
          : '';

        if (item.found) {
          card.className = "glass-card rounded-2xl p-5 flex flex-col justify-between border-l-4 border-l-emerald-400";
          card.innerHTML = `
            <div class="space-y-2.5">
              <div class="flex flex-wrap items-center justify-between gap-1.5">
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Playing in Austin
                </span>
                <div class="flex items-center gap-1.5">
                  ${appleBadge}
                  <span class="text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-400">${escapeHTML(item.mode)}</span>
                </div>
              </div>

              <div>
                <h3 class="text-lg font-extrabold text-white tracking-tight">${escapeHTML(item.artist)}</h3>
                ${item.genre ? `<p class="text-[11px] text-slate-400">${escapeHTML(item.genre)}</p>` : ''}
              </div>

              <div class="bg-slate-900/75 rounded-xl p-3 border border-slate-800/90 space-y-1">
                <div class="text-xs font-bold text-pink-300 flex items-center gap-1.5">
                  <i class="fa-solid fa-location-dot text-pink-400"></i>
                  <span>${escapeHTML(item.venue)}</span>
                </div>
                <div class="text-xs text-slate-200 flex items-center gap-1.5">
                  <i class="fa-regular fa-calendar text-slate-400"></i>
                  <span>${escapeHTML(item.date)}</span>
                </div>
                ${item.price ? `
                <div class="text-[11px] text-emerald-300/90 flex items-center gap-1.5 pt-0.5">
                  <i class="fa-solid fa-ticket text-emerald-400"></i>
                  <span>Est. ${escapeHTML(item.price)}</span>
                </div>` : ''}
              </div>
            </div>

            <div class="mt-4 pt-3 border-t border-white/10 space-y-2.5">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[11px] text-slate-400 truncate" title="${escapeHTML(item.eventName)}">${escapeHTML(item.eventName)}</span>
                <a href="${item.url}" target="_blank" rel="noopener noreferrer" 
                   class="px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-pink-600 to-rose-600 hover:from-pink-500 hover:to-rose-500 text-white text-xs font-bold transition shrink-0 shadow-md shadow-pink-600/20">
                  Tickets <i class="fa-solid fa-arrow-up-right-from-square text-[10px] ml-1"></i>
                </a>
              </div>
              <div class="flex items-center justify-between text-[10px] text-slate-400 pt-1">
                <span>Cross-check ATX calendars:</span>
                <div class="flex items-center gap-2">
                  <a href="${do512Url}" target="_blank" rel="noopener noreferrer" class="hover:text-pink-400 underline">Do512</a>
                  <span>•</span>
                  <a href="${bandsintownUrl}" target="_blank" rel="noopener noreferrer" class="hover:text-pink-400 underline">Bandsintown</a>
                  <span>•</span>
                  <a href="${songkickUrl}" target="_blank" rel="noopener noreferrer" class="hover:text-pink-400 underline">Songkick</a>
                </div>
              </div>
            </div>
          `;
        } else {
          card.className = "glass-card rounded-2xl p-5 flex flex-col justify-between opacity-75 hover:opacity-100";
          card.innerHTML = `
            <div class="space-y-2">
              <div class="flex flex-wrap items-center justify-between gap-1.5">
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-slate-800 text-slate-400 border border-slate-700">
                  No Austin Dates Listed
                </span>
                ${appleBadge}
              </div>
              <h3 class="text-base font-bold text-slate-200">${escapeHTML(item.artist)}</h3>
              <p class="text-xs text-slate-400">${escapeHTML(item.error || 'No upcoming Austin shows found on Ticketmaster right now.')}</p>
            </div>

            <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-[11px] text-slate-400">
              <span>Check indie Austin listings:</span>
              <div class="flex items-center gap-2 font-medium text-slate-300">
                <a href="${do512Url}" target="_blank" rel="noopener noreferrer" class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-pink-300 transition">Do512</a>
                <a href="${bandsintownUrl}" target="_blank" rel="noopener noreferrer" class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 transition">Bandsintown</a>
              </div>
            </div>
          `;
        }

        container.appendChild(card);
      });
    }

    function exportMatchesToCSV() {
      const playing = scanResults.filter(r => r.found);
      if (playing.length === 0) {
        showToast('No Austin shows to export yet.', 'info');
        return;
      }

      const headers = ['Artist', 'Event Name', 'Austin Venue', 'Date & Time', 'Apple Music Track Count', 'Ticket URL'];
      const rows = playing.map(r => [
        `"${(r.artist || '').replace(/"/g, '""')}"`,
        `"${(r.eventName || '').replace(/"/g, '""')}"`,
        `"${(r.venue || '').replace(/"/g, '""')}"`,
        `"${(r.date || '').replace(/"/g, '""')}"`,
        r.trackCount || 1,
        `"${(r.url || '').replace(/"/g, '""')}"`
      ]);

      const csvContent = [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'austin_apple_music_shows.csv';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('Exported upcoming Austin shows to CSV!', 'success');
    }

    // =========================================================================
    // FORMATTING & SANITIZATION UTILITIES
    // =========================================================================
    function formatReadableDate(isoDateStr) {
      const parts = isoDateStr.split('-');
      if (parts.length !== 3) return isoDateStr;
      const dateObj = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
      return dateObj.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
    }

    function formatTime(timeStr) {
      const [h, m] = timeStr.split(':');
      const hour = parseInt(h, 10);
      const ampm = hour >= 12 ? 'PM' : 'AM';
      const hour12 = hour % 12 || 12;
      return `• ${hour12}:${m} ${ampm}`;
    }

    function decodeHTMLEntities(text) {
      const textArea = document.createElement('textarea');
      textArea.innerHTML = text;
      return textArea.value;
    }

    function escapeHTML(str) {
      return String(str || '').replace(/[&<>"']/g, m => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[m]));
    }

    function escapeJS(str) {
      return String(str || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");
    }
  </script>
