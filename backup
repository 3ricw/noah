    function addSingleArtist(name, trackCount = 1, genre = '') {
      const cleanName = name.trim();
      if (!cleanName) return;
      const key = cleanName.toLowerCase();
      const existing = artistMetadataMap.get(key);
      if (existing) {
        existing.trackCount = (existing.trackCount || 1) + trackCount;
        if (genre && !existing.genre) existing.genre = genre;
      } else {
        artistMetadataMap.set(key, { name: cleanName, trackCount, genre });
      }
      renderArtistTextareaAndChips();
    }

    // =========================================================================
    // STEP 1B: APPLE MUSIC PLAYLIST / LIBRARY FILE PARSER (.XML, .TXT, .CSV)
    // =========================================================================
    function setupDropzone() {
      const dropzone = document.getElementById('dropzone');
      const fileInput = document.getElementById('fileInput');

      ['dragenter', 'dragover'].forEach(evt => {
        dropzone.addEventListener(evt, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('dropzone-active');
        });
      });

      ['dragleave', 'drop'].forEach(evt => {
        dropzone.addEventListener(evt, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('dropzone-active');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const files = e.dataTransfer?.files;
        if (files && files.length > 0) {
          processUploadedFile(files[0]);
        }
      });

      fileInput.addEventListener('change', (e) => {
        if (e.target.files && e.target.files.length > 0) {
          processUploadedFile(e.target.files[0]);
          fileInput.value = '';
        }
      });
    }

    function processUploadedFile(file) {
      const reader = new FileReader();
      reader.onload = function(event) {
        const content = event.target.result;
        parseAppleMusicContent(content, file.name);
      };
      reader.readAsText(file);
    }

    function parseAppleMusicContent(text, filename = 'export.xml') {
      const counts = new Map(); // lower -> { name, trackCount, genre }
      const lowerFilename = filename.toLowerCase();

      if (lowerFilename.endsWith('.xml') || text.includes('<plist') || text.includes('<key>Artist</key>')) {
        // Parse Apple Music XML plist format: extract Artist and optional Genre per track dict
        const dictRegex = /<dict>([\s\S]*?)<\/dict>/gi;
        let dictMatch;
        while ((dictMatch = dictRegex.exec(text)) !== null) {
          const block = dictMatch[1];
          const artistMatch = /<key>Artist<\/key>\s*<string>([^<]+)<\/string>/i.exec(block);
          if (artistMatch) {
            const rawArtist = decodeHTMLEntities(artistMatch[1].trim());
            const genreMatch = /<key>Genre<\/key>\s*<string>([^<]+)<\/string>/i.exec(block);
            const genre = genreMatch ? decodeHTMLEntities(genreMatch[1].trim()) : '';

            if (rawArtist && rawArtist.length > 1) {
              const key = rawArtist.toLowerCase();
              const prev = counts.get(key);
              if (prev) {
                prev.trackCount += 1;
                if (!prev.genre && genre) prev.genre = genre;
              } else {
                counts.set(key, { name: rawArtist, trackCount: 1, genre });
              }
            }
          }
        }
      } else {
        // Parse Apple Music Tab-Delimited .txt export or .csv export
        const lines = text.split(/\r?\n/).filter(l => l.trim().length > 0);
        if (lines.length > 0) {
          const firstLine = lines[0];
          const isTab = firstLine.includes('\t');
          const delimiter = isTab ? '\t' : ',';
          const headers = firstLine.split(delimiter).map(h => h.replace(/["']/g, '').trim().toLowerCase());

          // Locate "Artist" column index in Apple Music TXT/CSV exports (usually index 1)
          let artistIdx = headers.findIndex(h => h === 'artist' || h === 'artist name');
          let genreIdx = headers.findIndex(h => h === 'genre');
          const hasHeader = artistIdx !== -1 || headers.includes('name') || headers.includes('track name');
          if (artistIdx === -1) artistIdx = 0;

          const startRow = hasHeader ? 1 : 0;
          for (let i = startRow; i < lines.length; i++) {
            const cols = lines[i].split(delimiter).map(c => c.replace(/^["']|["']$/g, '').trim());
            const artistName = cols[artistIdx];
            const genreName = genreIdx !== -1 ? cols[genreIdx] : '';

            if (artistName && artistName.length > 1 && artistName.toLowerCase() !== 'artist') {
              const key = artistName.toLowerCase();
              const prev = counts.get(key);
              if (prev) {
                prev.trackCount += 1;
              } else {
                counts.set(key, { name: artistName, trackCount: 1, genre: genreName || '' });
              }
            }
          }
        }
      }

      if (counts.size === 0) {
        showToast(`Could not detect any artists in "${filename}". Check the file format.`, 'error');
        return;
      }

      // Sort by trackCount descending so the user's most-listened Apple Music artists are prioritized
      const sortedArtists = Array.from(counts.values()).sort((a, b) => b.trackCount - a.trackCount);
      const maxLimit = parseInt(document.getElementById('maxScanSelect').value, 10) || 30;
      const sliced = sortedArtists.slice(0, maxLimit);

      artistMetadataMap.clear();
      let totalTracks = 0;
      sliced.forEach(item => {
        artistMetadataMap.set(item.name.toLowerCase(), item);
        totalTracks += item.trackCount;
      });

      const badge = document.getElementById('libraryStatsBadge');
      badge.textContent = `Parsed ${counts.size} artists (${totalTracks} tracks)`;
      badge.classList.remove('hidden');

      renderArtistTextareaAndChips();
      showToast(`Imported top ${sliced.length} artists from "${filename}" sorted by library track count!`, 'success');
    }

