<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Apple Music to ATX Shows — Austin Gig Finder</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            apple: {
              pink: '#FA243C',
              red: '#fc3c44',
              dark: '#161618',
            },
            atx: {
              orange: '#BF5700',
              violet: '#7c3aed'
            }
          }
        }
      }
    }
  </script>

  <style>
    body {
      background: radial-gradient(circle at 15% 15%, #2e1065 0%, #0f172a 45%, #090d16 100%);
      min-height: 100vh;
      color: #f8fafc;
      font-family: 'Inter', sans-serif;
    }
    .glass {
      background: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.09);
    }
    .glass-card {
      background: rgba(30, 41, 59, 0.45);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .glass-card:hover {
      border-color: rgba(250, 36, 60, 0.4);
      transform: translateY(-2px);
      box-shadow: 0 12px 30px -10px rgba(250, 36, 60, 0.15);
    }
    .dropzone-active {
      border-color: #FA243C !important;
      background: rgba(250, 36, 60, 0.12) !important;
    }
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.4);
      border-radius: 8px;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, 0.3);
      border-radius: 8px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(250, 36, 60, 0.6);
    }
  </style>
</head>
<body class="p-4 sm:p-6 md:p-10 selection:bg-pink-500 selection:text-white">

  <!-- Toast Notification Container -->
  <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2.5 max-w-sm w-full pointer-events-none"></div>

  <!-- Sample File Format Modal -->
  <div id="formatModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 backdrop-blur-sm p-4">
    <div class="glass max-w-2xl w-full rounded-2xl p-6 border border-slate-700 shadow-2xl space-y-4">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="text-lg font-bold text-white flex items-center gap-2">
          <i class="fa-brands fa-apple text-pink-500"></i> Exporting Your Apple Music Library
        </h3>
        <button onclick="toggleFormatModal(false)" class="text-slate-400 hover:text-white p-1 rounded-lg">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>
      <div class="space-y-3 text-xs sm:text-sm text-slate-300 leading-relaxed">
        <p class="font-medium text-pink-300">Why export an XML or TXT file?</p>
        <p>Apple's MusicKit API requires a $99/year Apple Developer account to sign authentication tokens. By exporting a playlist or library file from the desktop Music app, you can parse <strong>thousands of your actual listened tracks locally in your browser in 1 second</strong>—with 100% privacy and zero fees.</p>
        <div class="bg-slate-900/90 rounded-xl p-4 border border-slate-800 space-y-2">
          <div class="font-semibold text-white">Step-by-Step on Mac or Windows:</div>
          <ol class="list-decimal list-inside space-y-1.5 text-slate-300">
            <li>Open the <strong>Apple Music</strong> app on your Mac or PC.</li>
            <li>Select any Playlist in the sidebar (or click <strong>Songs</strong> under Library to export everything).</li>
            <li>In the top menu bar, click <strong>File &rarr; Library &rarr; Export Playlist...</strong> (or <em>Export Library...</em>).</li>
            <li>Choose <strong>XML</strong> or <strong>Plain Text (.txt)</strong> as the format and save it to your computer.</li>
            <li>Drag and drop that file directly into the upload box on this page!</li>
          </ol>
        </div>
        <p class="text-xs text-slate-400">Our parser automatically extracts every artist name, counts how many songs you have by each artist, and ranks your top artists so you can scan your favorites first.</p>
      </div>
      <div class="flex justify-end pt-2">
        <button onclick="toggleFormatModal(false)" class="px-4 py-2 rounded-xl bg-pink-600 hover:bg-pink-500 text-white font-semibold text-xs transition">
          Got It, Let's Go
        </button>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto space-y-6">

    <!-- Top Header & Live Status Pill -->
    <header class="flex flex-col md:flex-row items-center justify-between gap-4 border-b border-white/10 pb-6">
      <div class="flex items-center gap-4 text-center md:text-left">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-pink-500 via-rose-600 to-purple-700 flex items-center justify-center shadow-lg shadow-pink-500/25 shrink-0">
          <i class="fa-solid fa-guitar text-2xl text-white"></i>
        </div>
        <div>
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 mb-1">
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-pink-500/20 text-pink-300 border border-pink-500/30">
              <i class="fa-brands fa-apple mr-1"></i> Apple Music Sync
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/30">
              <i class="fa-solid fa-location-dot mr-1"></i> Austin, TX (Live Music Capital)
            </span>
          </div>
          <h1 class="text-2xl sm:text-4xl font-black tracking-tight text-white">
            Apple Music <span class="text-transparent bg-clip-text bg-gradient-to-r from-pink-400 via-rose-400 to-amber-400">to ATX Shows</span>
          </h1>
          <p class="text-slate-400 text-xs sm:text-sm mt-0.5">
            Import your Apple Music artists &amp; instantly discover when they play live in Austin.
          </p>
        </div>
      </div>

      <!-- Right Controls: Mode Badge & Onboarding Guide Toggle -->
      <div class="flex flex-wrap items-center justify-center gap-2.5">
        <div id="apiStatusBadge" class="px-3.5 py-2 rounded-xl bg-slate-800/90 border border-slate-700 flex items-center gap-2 text-xs font-medium">
          <span id="apiStatusDot" class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
          <span id="apiStatusText" class="text-slate-200">Mode: Demo Simulation</span>
        </div>
        <button onclick="toggleOnboardingDrawer()" id="guideToggleBtn" class="px-3.5 py-2 rounded-xl bg-pink-600/20 hover:bg-pink-600/30 text-pink-300 border border-pink-500/30 text-xs font-semibold flex items-center gap-2 transition">
          <i class="fa-solid fa-circle-question"></i>
          <span>How to Use with Live Data</span>
          <i id="guideChevron" class="fa-solid fa-chevron-up text-[10px] transition-transform"></i>
        </button>
      </div>
    </header>

    <!-- INTERACTIVE ONBOARDING GUIDE ("How to use it with real live data") -->
    <section id="onboardingDrawer" class="glass rounded-2xl p-5 sm:p-6 border border-pink-500/30 shadow-2xl space-y-5 transition-all">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-white/10 pb-4">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-lg bg-pink-500/20 border border-pink-500/40 flex items-center justify-center text-pink-400 font-bold text-xs">
            <i class="fa-solid fa-bolt"></i>
          </span>
          <div>
            <h2 class="text-base sm:text-lg font-bold text-white">How to Use This App with Real Live Data</h2>
            <p class="text-xs text-slate-400">Follow these 2 quick steps to connect your real Apple Music library &amp; live Austin concert feeds.</p>
          </div>
        </div>
        <button onclick="toggleOnboardingDrawer()" class="self-end sm:self-center text-xs text-slate-400 hover:text-white flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-800/60">
          <span>Hide Guide</span> <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- STEP 1: Exporting from Apple Music + Live iTunes Search -->
        <div class="bg-slate-900/60 rounded-xl p-4 sm:p-5 border border-slate-800 flex flex-col justify-between space-y-4">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-md bg-pink-500/20 text-pink-300 font-bold text-xs">
                STEP 1 • APPLE MUSIC ARTISTS
              </span>
              <button onclick="toggleFormatModal(true)" class="text-xs text-pink-400 hover:underline flex items-center gap-1">
                <i class="fa-regular fa-circle-question"></i> Detailed Visual Guide
              </button>
            </div>
            <h3 class="text-sm sm:text-base font-bold text-white">
              1. Exporting from Apple Music
            </h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              In the <strong>Apple Music desktop app</strong>, click <code class="px-1.5 py-0.5 rounded bg-slate-800 text-pink-300 font-mono">File &rarr; Library &rarr; Export Playlist...</code> (choose <strong>XML</strong> or <strong>TXT</strong>) and upload or drag-and-drop it directly into the box below.
            </p>

            <!-- Live Apple Music / iTunes Artist Search Bar -->
            <div class="pt-2 space-y-2">
              <label class="block text-xs font-semibold text-slate-300">
                <i class="fa-brands fa-apple text-pink-400 mr-1"></i> Don't have your desktop app open? Search Apple Music's live catalog right here:
              </label>
              <div class="relative">
                <div class="flex gap-2">
                  <div class="relative flex-1">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" id="itunesSearchInput" 
                      placeholder="Search any artist on Apple Music (e.g., Khruangbin, Leon Bridges)..."
                      class="w-full pl-9 pr-3 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-xs sm:text-sm text-white placeholder-slate-500 focus:outline-none focus:border-pink-500">
                  </div>
                  <button onclick="searchAppleMusicCatalog()" id="itunesSearchBtn" class="px-4 py-2.5 rounded-xl bg-pink-600 hover:bg-pink-500 text-white font-semibold text-xs transition shrink-0">
                    Search Apple
                  </button>
                </div>
                <!-- Autocomplete Dropdown Results -->
                <div id="itunesResultsDropdown" class="hidden mt-2 bg-slate-900 border border-slate-700 rounded-xl shadow-2xl max-h-52 overflow-y-auto divide-y divide-slate-800 z-30"></div>
              </div>
            </div>
          </div>

          <div class="pt-2 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-2 text-[11px] text-slate-400">
            <span>Supports <code class="text-slate-300">.xml</code>, <code class="text-slate-300">.txt</code>, <code class="text-slate-300">.csv</code>, <code class="text-slate-300">.m3u</code></span>
            <button onclick="loadSampleAppleMusicXML()" class="text-pink-400 hover:text-pink-300 font-semibold flex items-center gap-1">
              <i class="fa-solid fa-wand-magic-sparkles"></i> Load Sample Apple Music XML Export
            </button>
          </div>
        </div>

        <!-- STEP 2: Real Concert Data (Ticketmaster API Key Setup + Verification) -->
        <div class="bg-slate-900/60 rounded-xl p-4 sm:p-5 border border-slate-800 flex flex-col justify-between space-y-4">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-md bg-emerald-500/20 text-emerald-300 font-bold text-xs">
                STEP 2 • REAL CONCERT DATA
              </span>
              <a href="https://developer.ticketmaster.com/" target="_blank" rel="noopener noreferrer" 
                 class="text-xs text-emerald-400 hover:underline font-medium flex items-center gap-1">
                developer.ticketmaster.com <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
              </a>
            </div>
            <h3 class="text-sm sm:text-base font-bold text-white">
              2. Connect Ticketmaster Discovery API
            </h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Create a free account at <a href="https://developer.ticketmaster.com/" target="_blank" rel="noopener noreferrer" class="text-pink-400 underline hover:text-pink-300">developer.ticketmaster.com</a>, copy your <strong>Consumer Key</strong> from your default app, and paste it below to fetch real live Austin dates instead of simulated demo venues.
            </p>

            <!-- API Key Input + Save & Test -->
            <div class="space-y-2 pt-1">
              <label class="block text-xs font-semibold text-slate-300">
                Ticketmaster Consumer Key (Auto-saved to your browser):
              </label>
              <div class="flex flex-col sm:flex-row gap-2">
                <div class="relative flex-1">
                  <i class="fa-solid fa-key absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                  <input type="password" id="apiKeyInput" 
                    placeholder="Paste your Ticketmaster Consumer Key here..."
                    oninput="handleApiKeyChange()"
                    class="w-full pl-9 pr-9 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-xs sm:text-sm text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500">
                  <button onclick="toggleKeyVisibility()" type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white text-xs" title="Show/Hide Key">
                    <i id="keyEyeIcon" class="fa-regular fa-eye"></i>
                  </button>
                </div>
                <button onclick="testTicketmasterKey()" id="testKeyBtn" class="px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs transition shrink-0 flex items-center justify-center gap-1.5">
                  <i class="fa-solid fa-plug-circle-check"></i> Test &amp; Save Key
                </button>
              </div>
              <div id="keyTestResult" class="text-xs hidden rounded-lg p-2.5 border"></div>
            </div>
          </div>

          <div class="pt-2 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-2 text-[11px] text-slate-400">
            <span>No key? Every artist card still gets 1-click links to <strong>Do512, Songkick &amp; Bandsintown</strong>!</span>
            <button onclick="clearSavedKey()" class="text-slate-400 hover:text-rose-400 transition">
              Clear Saved Key
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- MAIN WORKSPACE: Left (Library Importer & Artist Manager) | Right (Austin Shows Feed) -->
    <div class="grid lg:grid-cols-12 gap-6">

      <!-- LEFT COLUMN (5 cols): Apple Music Upload & Artist Queue -->
      <div class="lg:col-span-5 space-y-5">
        <div class="glass rounded-2xl p-5 space-y-5 shadow-xl">
          
          <!-- Drag & Drop Zone for Apple Music Export -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="text-xs font-bold uppercase tracking-wider text-slate-300 flex items-center gap-1.5">
                <i class="fa-solid fa-file-arrow-up text-pink-400"></i> Upload Apple Music Export
              </label>
              <span id="libraryStatsBadge" class="text-[11px] text-pink-300 font-medium hidden"></span>
            </div>

            <div id="dropzone" 
                 class="border-2 border-dashed border-slate-700 hover:border-pink-500/60 rounded-2xl p-5 text-center transition cursor-pointer bg-slate-900/40 group"
                 onclick="document.getElementById('fileInput').click()">
              <input type="file" id="fileInput" accept=".xml,.txt,.csv,.m3u" class="hidden">
              <div class="w-10 h-10 rounded-xl bg-pink-500/10 border border-pink-500/20 flex items-center justify-center mx-auto mb-2.5 group-hover:scale-110 transition">
                <i class="fa-brands fa-apple text-xl text-pink-400"></i>
              </div>
              <p class="text-xs sm:text-sm font-semibold text-white">
                Drag &amp; drop your <span class="text-pink-400">Library.xml</span> or <span class="text-pink-400">Playlist.txt</span> here
              </p>
              <p class="text-[11px] text-slate-400 mt-1">
                File &rarr; Library &rarr; Export Playlist... (Automatically ranks by play/track count)
              </p>
            </div>
          </div>

          <!-- Filter & Sort Controls for Imported Artists -->
          <div class="space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <label class="text-xs font-bold uppercase tracking-wider text-slate-300">
                Artists to Scan (<span id="artistCountLabel">0</span>)
              </label>
              <div class="flex items-center gap-1.5">
                <button onclick="addAustinPresetArtists()" class="text-[11px] px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition" title="Add popular touring artists">
                  + Sample Roster
                </button>
                <button onclick="clearArtistsList()" class="text-[11px] px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-rose-950/60 text-slate-400 hover:text-rose-300 border border-slate-700 transition">
                  Clear
                </button>
              </div>
            </div>

            <!-- Interactive Pills View vs Raw Text View Toggle -->
            <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-3 space-y-3">
              <div class="flex items-center justify-between border-b border-slate-800/80 pb-2">
                <span class="text-[11px] text-slate-400">Edit list (one artist per line) or use tags below:</span>
                <select id="maxScanSelect" class="bg-slate-900 border border-slate-700 rounded-lg text-[11px] text-slate-200 px-2 py-1 focus:outline-none">
                  <option value="15">Scan Top 15 Artists</option>
                  <option value="30" selected>Scan Top 30 Artists</option>
                  <option value="50">Scan Top 50 Artists</option>
                  <option value="100">Scan Up to 100 Artists</option>
                </select>
              </div>

              <textarea id="artistInput" rows="6" 
                oninput="syncTextToArtistMap()"
                class="w-full rounded-lg bg-slate-900/90 border border-slate-800 p-2.5 text-xs sm:text-sm text-white placeholder-slate-500 focus:outline-none focus:border-pink-500 font-medium leading-relaxed"
                placeholder="Paste artists here (one per line)...&#10;Khruangbin&#10;Black Pumas&#10;Spoon"></textarea>

              <!-- Parsed Artist Chips with Apple Music Track Counts -->
              <div id="artistChipsContainer" class="flex flex-wrap gap-1.5 max-h-36 overflow-y-auto pt-1"></div>
            </div>
          </div>

          <!-- Scan Options & Main Action Button -->
          <div class="space-y-3 pt-1">
            <div class="flex items-center justify-between text-xs bg-slate-900/70 px-3.5 py-2.5 rounded-xl border border-slate-800">
              <div class="flex items-center gap-2">
                <input type="checkbox" id="includeSurroundingCities" checked class="rounded accent-pink-500 w-3.5 h-3.5 cursor-pointer">
                <label for="includeSurroundingCities" class="text-slate-300 cursor-pointer select-none text-[11px] sm:text-xs">
                  Include Greater Austin (Cedar Park, Del Valle / COTA, Buda)
                </label>
              </div>
            </div>

            <button id="scanBtn" onclick="scanForShows()" 
              class="w-full py-3.5 px-6 rounded-xl font-bold text-sm text-white bg-gradient-to-r from-pink-600 via-rose-600 to-purple-600 hover:from-pink-500 hover:to-purple-500 shadow-lg shadow-pink-600/25 transition transform active:scale-[0.99] flex items-center justify-center gap-2">
              <i class="fa-solid fa-satellite-dish"></i>
              <span id="scanBtnText">Scan Austin Venues for My Artists</span>
            </button>
          </div>

        </div>
      </div>

      <!-- RIGHT COLUMN (7 cols): Live Concert Results & Filter Tabs -->
      <div class="lg:col-span-7 space-y-4">
        
        <!-- Filter Bar & Stats Summary -->
        <div class="glass rounded-2xl p-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
          <!-- Filter Tabs -->
          <div class="flex items-center gap-1.5 bg-slate-900/90 p-1 rounded-xl border border-slate-800">
            <button onclick="setFilterTab('all')" id="tab-all" class="flex-1 sm:flex-initial px-3 py-1.5 rounded-lg text-xs font-semibold transition bg-pink-600 text-white">
              All (<span id="count-all">0</span>)
            </button>
            <button onclick="setFilterTab('playing')" id="tab-playing" class="flex-1 sm:flex-initial px-3 py-1.5 rounded-lg text-xs font-semibold transition text-slate-400 hover:text-white">
              <i class="fa-solid fa-fire text-emerald-400 mr-1"></i> Playing ATX (<span id="count-playing">0</span>)
            </button>
            <button onclick="setFilterTab('none')" id="tab-none" class="flex-1 sm:flex-initial px-3 py-1.5 rounded-lg text-xs font-semibold transition text-slate-400 hover:text-white">
              No Dates Yet (<span id="count-none">0</span>)
            </button>
          </div>

          <!-- Search Filter inside Results + Export -->
          <div class="flex items-center gap-2">
            <div class="relative flex-1 sm:w-44">
              <i class="fa-solid fa-filter absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-xs"></i>
              <input type="text" id="resultFilterInput" oninput="renderAllCards()" placeholder="Filter results..."
                class="w-full pl-8 pr-3 py-1.5 rounded-xl bg-slate-900 border border-slate-700 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-pink-500">
            </div>
            <button onclick="exportMatchesToCSV()" id="exportBtn" class="hidden px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs font-medium transition shrink-0" title="Export Austin shows to CSV">
              <i class="fa-solid fa-download mr-1"></i> CSV
            </button>
          </div>
        </div>

        <!-- Progress Bar Area (Shown during scanning) -->
        <div id="progressContainer" class="hidden glass rounded-2xl p-4 space-y-2 border border-pink-500/30">
          <div class="flex items-center justify-between text-xs">
            <span id="progressLabel" class="text-pink-300 font-semibold flex items-center gap-2">
              <i class="fa-solid fa-circle-notch fa-spin"></i> Scanning Austin venues...
            </span>
            <span id="progressPercent" class="text-slate-400 font-mono">0%</span>
          </div>
          <div class="w-full h-2 bg-slate-900 rounded-full overflow-hidden">
            <div id="progressBar" class="h-full bg-gradient-to-r from-pink-500 to-amber-400 width-0 transition-all duration-300" style="width: 0%"></div>
          </div>
        </div>

        <!-- Results Grid -->
        <div id="resultsGrid" class="grid sm:grid-cols-2 gap-4"></div>

        <!-- Empty State -->
        <div id="emptyState" class="glass rounded-2xl p-10 text-center space-y-3 border border-dashed border-slate-800">
          <div class="w-12 h-12 rounded-2xl bg-slate-800/80 flex items-center justify-center mx-auto text-slate-400">
            <i class="fa-solid fa-music text-xl"></i>
          </div>
          <h3 class="text-base font-bold text-white">Ready to Check Austin Venues</h3>
          <p class="text-xs text-slate-400 max-w-md mx-auto leading-relaxed">
