      try {
        const url = `https://itunes.apple.com/search?term=${encodeURIComponent(query)}&entity=musicArtist&limit=6`;
        const response = await fetch(url);
        const data = await response.json();

        dropdown.innerHTML = '';
        dropdown.classList.remove('hidden');

        if (!data.results || data.results.length === 0) {
          dropdown.innerHTML = `<div class="p-3 text-xs text-slate-400 text-center">No artists found on Apple Music for "${escapeHTML(query)}".</div>`;
        } else {
