    function syncTextToArtistMap() {
      const rawLines = document.getElementById('artistInput').value.split('\n');
      const updatedMap = new Map();

      rawLines.forEach(line => {
        const clean = line.trim();
        if (!clean) return;
        const key = clean.toLowerCase();
        const existing = artistMetadataMap.get(key);
        updatedMap.set(key, existing || { name: clean, trackCount: 1, genre: '' });
      });

      artistMetadataMap.clear();
      updatedMap.forEach((v, k) => artistMetadataMap.set(k, v));

      document.getElementById('artistCountLabel').textContent = artistMetadataMap.size;
      // Rebuild chips without overwriting cursor position in textarea
      const chipsContainer = document.getElementById('artistChipsContainer');
      chipsContainer.innerHTML = '';
      Array.from(artistMetadataMap.values()).forEach(item => {
        const chip = document.createElement('div');
        chip.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-700/80 text-[11px] text-slate-200';
        chip.innerHTML = `
