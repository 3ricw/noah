          ${item.trackCount > 1 ? `<span class="px-1.5 py-0.2 rounded bg-pink-500/20 text-pink-300 font-mono text-[10px]">${item.trackCount} songs</span>` : ''}
        `;
        chipsContainer.appendChild(chip);
      });
    }

