    async function testTicketmasterKey() {
      const key = document.getElementById('apiKeyInput').value.trim();
      const resultBox = document.getElementById('keyTestResult');
      const btn = document.getElementById('testKeyBtn');

      if (!key) {
        resultBox.className = 'text-xs rounded-lg p-2.5 border border-amber-500/40 bg-amber-950/50 text-amber-200 block';
        resultBox.innerHTML = `<i class="fa-solid fa-circle-exclamation mr-1"></i> Paste your Consumer Key from <a href="https://developer.ticketmaster.com/" target="_blank" class="underline font-semibold">developer.ticketmaster.com</a> first.`;
        return;
      }

      btn.disabled = true;
      btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Testing...`;

      try {
        // Query 1 music event in Austin, TX to verify key validity
        const testUrl = `https://app.ticketmaster.com/discovery/v2/events.json?city=Austin&stateCode=TX&classificationName=music&size=1&apikey=${encodeURIComponent(key)}`;
        const resp = await fetch(testUrl);

        if (resp.ok) {
          const data = await resp.json();
          const totalAustinShows = data.page?.totalElements || 0;
          localStorage.setItem(STORAGE_KEY_TM, key);
          updateApiStatusBadge(true);

          resultBox.className = 'text-xs rounded-lg p-2.5 border border-emerald-500/40 bg-emerald-950/60 text-emerald-200 block';
          resultBox.innerHTML = `<i class="fa-solid fa-circle-check mr-1 text-emerald-400"></i> <strong>Connected!</strong> Key saved to browser. Ticketmaster currently lists <strong>${totalAustinShows.toLocaleString()}</strong> upcoming music events in Austin, TX.`;
          showToast('Ticketmaster API Key verified & saved!', 'success');
        } else {
          resultBox.className = 'text-xs rounded-lg p-2.5 border border-rose-500/40 bg-rose-950/60 text-rose-200 block';
          resultBox.innerHTML = `<i class="fa-solid fa-circle-xmark mr-1 text-rose-400"></i> Invalid Consumer Key (HTTP ${resp.status}). Make sure you copied the <strong>Consumer Key</strong> (not Consumer Secret).`;
        }
      } catch (err) {
        resultBox.className = 'text-xs rounded-lg p-2.5 border border-rose-500/40 bg-rose-950/60 text-rose-200 block';
        resultBox.innerHTML = `<i class="fa-solid fa-triangle-exclamation mr-1"></i> Network error verifying API key. Check your connection.`;
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<i class="fa-solid fa-plug-circle-check"></i> Test & Save Key`;
      }
    }

